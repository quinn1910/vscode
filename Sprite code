import pygame

pygame.init()

# Set up display
size = [640, 480]
screen = pygame.display.set_mode(size)
pygame.display.set_caption("Simple Sprite Example")

# Load the sprite image
sprite_image = pygame.image.load("sprite.png").convert_alpha()

# Get the dimensions of the image
sprite_width = sprite_image.get_width()
sprite_height = sprite_image.get_height()

# Initial sprite position
sprite_x = 50
sprite_y = 50

# Game loop
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Clear the screen
    screen.fill((0, 0, 0))  # Fill with black

    # Draw the sprite
    screen.blit(sprite_image, (sprite_x, sprite_y))

    # Update the display
    pygame.display.flip()

pygame.quit()
